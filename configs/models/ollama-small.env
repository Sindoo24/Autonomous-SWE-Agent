# First real-model experiment: the smallest practical model already supported by the project.
# One model for both roles, so Ollama never swaps models in and out of VRAM.
# qwen2.5-coder:7b (Q4_K_M, ~4.7 GB) + 16k context needs ~6 GB VRAM; runs on CPU too, slowly.
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
MODEL_REASONING=qwen2.5-coder:7b
MODEL_CODER=qwen2.5-coder:7b
MODEL_TOOL_MODE=json_action
MODEL_TEMPERATURE=0
MODEL_SEED=7
MODEL_NUM_CTX=16384
MODEL_MAX_OUTPUT_TOKENS=2048
# qwen2.5-coder has no thinking mode: do not send the `think` field at all
MODEL_THINK=none
MODEL_TIMEOUT_S=600

# Keep every prompt well inside the 16k-token window (Ollama silently truncates overflow):
# at most ~6 recent tool outputs x 6000 chars stay unelided in a tool loop.
SWE_TOOL_OUTPUT_MAX_CHARS=6000
SWE_LOOP_CONTEXT_MAX_CHARS=36000
SWE_LOG_LEVEL=INFO

# Local 7B models are slow; give each task an hour of wall clock.
BUDGET_MAX_WALL_SECONDS=3600

# Sandbox defaults (python:3.12-slim from Docker Hub) are used as-is.

# Agent behaviour (defaults shown). `bench run` and the live test always use auto approval.
# AGENT_REPRODUCE=true            # write + check a failing reproduction test before implementing
# AGENT_REPRODUCE_ATTEMPTS=3
# AGENT_LLM_FAILURE_ANALYSIS=true # model-based root-cause analysis after a failed test run
# AGENT_APPROVAL=manual           # `swe-agent run` pauses for `swe-agent approve|reject`
# AGENT_LINT=true                 # L4: no new ruff E9/F findings

# The API, worker and experiments also need SWE_DATABASE_URL: see .env.example.
