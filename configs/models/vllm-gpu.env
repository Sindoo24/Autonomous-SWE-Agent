# GPU server: vLLM OpenAI-compatible endpoint, e.g.
#   vllm serve Qwen/Qwen3-Coder-30B-A3B-Instruct --max-model-len 32768
MODEL_PROVIDER=openai_compatible
MODEL_BASE_URL=http://gpu-host:8000/v1
MODEL_API_KEY=
MODEL_REASONING=Qwen/Qwen3-Coder-30B-A3B-Instruct
MODEL_CODER=Qwen/Qwen3-Coder-30B-A3B-Instruct
MODEL_TOOL_MODE=json_action
MODEL_TEMPERATURE=0
MODEL_SEED=7
MODEL_MAX_OUTPUT_TOKENS=4096
