# Autonomous SWE Agent: every setting, with its default.
#
#   cp .env.example .env
#
# Used by: `swe-agent --env-file .env ...` (CLI, API, worker on the host) and by
# docker-compose.yml (variable substitution, and passed into the backend / worker containers).
# Model presets in configs/models/*.env override the MODEL_* block for a given setup:
#   swe-agent --env-file configs/models/ollama-small.env run ...
# Values are read as-is: keep comments on their own lines. Never commit your .env.

# =============================================================================== model
# ollama | openai_compatible (vLLM, llama.cpp server, LM Studio, any /v1/chat/completions)
MODEL_PROVIDER=ollama
MODEL_BASE_URL=http://localhost:11434
# Only for OpenAI-compatible servers that need one.
MODEL_API_KEY=
# Model used for explore / hypothesize / plan / failure analysis
MODEL_REASONING=qwen3:8b
# Model used for implement (code edits)
MODEL_CODER=qwen2.5-coder:7b
# json_action (works with any model) | native_tools (provider tool calling)
MODEL_TOOL_MODE=json_action
MODEL_TEMPERATURE=0
MODEL_SEED=7
MODEL_MAX_OUTPUT_TOKENS=2048
# Ollama context window (ignored by OpenAI-compatible servers)
MODEL_NUM_CTX=16384
MODEL_TIMEOUT_S=300
MODEL_MAX_RETRIES=2
# false: disable Qwen3-style thinking output. none: do not send the field at all (models
# without a thinking mode, e.g. qwen2.5-coder).
MODEL_THINK=false

# =============================================================================== budget (per run)
BUDGET_MAX_ITERATIONS=5
BUDGET_MAX_TOOL_CALLS=80
BUDGET_MAX_TOKENS=400000
BUDGET_MAX_WALL_SECONDS=1800
BUDGET_EXPLORE_MAX_STEPS=25
BUDGET_IMPLEMENT_MAX_STEPS=20
BUDGET_MAX_VALIDATION_ATTEMPTS=3

# =============================================================================== agent behaviour
# Write and check a failing reproduction test before implementing
AGENT_REPRODUCE=true
AGENT_REPRODUCE_ATTEMPTS=3
# Model-based root-cause analysis after a failed test run
AGENT_LLM_FAILURE_ANALYSIS=true
# manual: pause before exporting the patch until approved / rejected. auto: approve.
AGENT_APPROVAL=manual
# Verification level 4: no new ruff E9/F findings in changed files
AGENT_LINT=true
# Optional level 5: a directory of acceptance test_*.py files the agent never sees
# AGENT_ACCEPTANCE_DIR=/path/to/acceptance_tests
# Evaluation ablations (defaults = the full system): classified | generic
AGENT_FAILURE_ROUTING=classified
AGENT_CANDIDATE_SEEDING=true

# =============================================================================== sandbox (Docker)
# Everything that executes repository or generated code runs in these containers:
# --network none, read-only root filesystem, no capabilities, unprivileged user, limits below.
# false: patches are generated and statically validated, never executed.
SANDBOX_ENABLED=true
SANDBOX_DOCKER_BIN=docker
# Any image with python3 + venv. Without Docker Hub: scripts/build_local_base_image.sh,
# then SANDBOX_BASE_IMAGE=swe-agent/ubuntu-python:noble and SANDBOX_MANYLINUX_MAX=2_39.
SANDBOX_BASE_IMAGE=python:3.12-slim
# Must match the base image
SANDBOX_PYTHON_VERSION=3.12
# Highest manylinux glibc level of the base image (Debian 12 = 2_36, Ubuntu 24.04 = 2_39)
SANDBOX_MANYLINUX_MAX=2_36
SANDBOX_USER=10001:10001
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_TMPFS_SIZE=256m
SANDBOX_NOFILE=1024
# e.g. runsc (gVisor) for stronger isolation; empty = Docker's default runtime
SANDBOX_RUNTIME=
SANDBOX_TEST_TIMEOUT_S=300
SANDBOX_IMPORT_TIMEOUT_S=60
SANDBOX_BUILD_TIMEOUT_S=900
SANDBOX_MAX_OUTPUT_BYTES=1000000
# Installed into every dependency image (JSON list). Default: ["pytest","ruff"]
# SANDBOX_EXTRA_REQUIREMENTS=["pytest","ruff"]

# =============================================================================== paths, logging, prompts
SWE_WORKSPACE_ROOT=./.data/workspaces
SWE_ARTIFACTS_ROOT=./.data/artifacts
# SQLite checkpoints, used only when SWE_DATABASE_URL is not set (CLI mode)
SWE_CHECKPOINT_DB=./.data/checkpoints.sqlite
# Benchmark dataset (repos/ + tasks/); relative paths resolve against the working directory
SWE_BENCHMARKS_DIR=./benchmarks
SWE_LOG_LEVEL=INFO
SWE_LOG_JSON=true
# Characters of tool output shown to the model per call
SWE_TOOL_OUTPUT_MAX_CHARS=12000
# Tool-loop conversation size before old tool outputs are elided
SWE_LOOP_CONTEXT_MAX_CHARS=60000
SWE_MAX_PATCH_CHANGED_LINES=200

# =============================================================================== database, API, worker
# Required by the API, the worker and experiments. Comment it out for the files-only CLI mode
# (`swe-agent run`). Matches the postgres service in docker-compose.yml.
SWE_DATABASE_URL=postgresql://swe:swe@localhost:5432/swe_agent
# Static API key (header X-API-Key). Required for any non-localhost bind and by
# docker-compose.yml. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
SWE_API_KEY=
# Local repository directories the API accepts, comma-separated (https git URLs always are)
SWE_API_REPO_ROOTS=.
SWE_WORKER_POLL_SECONDS=2
SWE_WORKER_HEARTBEAT_SECONDS=10
# A running job without a heartbeat for this long is requeued and resumed from its checkpoint
SWE_WORKER_STALE_SECONDS=120
SWE_JOB_MAX_ATTEMPTS=3

# =============================================================================== tracing
# jsonl (spans.jsonl per run) | otlp (Jaeger: docker compose --profile jaeger) | console | none
SWE_OTEL_EXPORTER=jsonl
SWE_OTEL_ENDPOINT=http://localhost:4318/v1/traces

# =============================================================================== UI
# Where the Streamlit UI finds the API (it also sends SWE_API_KEY)
SWE_API_URL=http://127.0.0.1:8000

# =============================================================================== docker compose only
# Absolute path for workspaces and artifacts. The worker starts sandboxes through the host's
# Docker daemon, which resolves bind mounts on the host, so this path is mounted at the same
# location in the containers. Must be writable by SWE_UID.
SWE_DATA_DIR=
# Host directory with local repositories to work on, mounted read-only at /repos
SWE_REPOS_DIR=./benchmarks/repos
# User the backend and worker run as (use your own: id -u / id -g)
SWE_UID=10001
SWE_GID=10001
# Group that owns the Docker socket: stat -c %g /var/run/docker.sock (0 on Docker Desktop)
DOCKER_GID=0
POSTGRES_PASSWORD=swe
POSTGRES_PORT=5432
SWE_API_PORT=8000
SWE_UI_PORT=8501
# Model endpoint as seen from inside the containers (Ollama on the host)
MODEL_BASE_URL_DOCKER=http://host.docker.internal:11434
SWE_OTEL_ENDPOINT_DOCKER=http://jaeger:4318/v1/traces
# Base images (override when Docker Hub is unreachable)
PYTHON_IMAGE=python:3.12-slim
DOCKER_CLI_IMAGE=docker:28-cli
POSTGRES_IMAGE=postgres:16-alpine

# =============================================================================== tests only
# Database for the PostgreSQL tests. It is WIPED on every test run.
# SWE_TEST_DATABASE_URL=postgresql://swe:swe@localhost:5432/swe_agent_test
# Live-model test (pytest -m live_model): SWE_LIVE_MODEL=1 SWE_LIVE_ENV=configs/models/ollama-small.env
