# Copy to .env or pass a profile with --env-file configs/models/<profile>.env
MODEL_PROVIDER=ollama              # ollama | openai_compatible
MODEL_BASE_URL=http://localhost:11434
MODEL_API_KEY=
MODEL_REASONING=qwen3:8b           # explore / hypothesize / plan
MODEL_CODER=qwen2.5-coder:7b       # implement
MODEL_TOOL_MODE=json_action        # json_action | native_tools
MODEL_TEMPERATURE=0
MODEL_SEED=7

SWE_WORKSPACE_ROOT=./.data/workspaces
SWE_ARTIFACTS_ROOT=./.data/artifacts
SWE_LOG_LEVEL=INFO

BUDGET_MAX_ITERATIONS=5
BUDGET_MAX_TOOL_CALLS=80
BUDGET_MAX_TOKENS=400000
BUDGET_MAX_WALL_SECONDS=1800
BUDGET_EXPLORE_MAX_STEPS=25
BUDGET_IMPLEMENT_MAX_STEPS=20

# Sandbox (Docker). Everything that executes repository or generated code runs here.
SANDBOX_ENABLED=true
SANDBOX_BASE_IMAGE=python:3.12-slim   # any image with python3 + venv
SANDBOX_PYTHON_VERSION=3.12           # must match the base image
SANDBOX_MANYLINUX_MAX=2_36            # glibc level of the base image (Debian 12 = 2_36)
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS_LIMIT=256
SANDBOX_TEST_TIMEOUT_S=300
SANDBOX_RUNTIME=                      # e.g. runsc (gVisor) for stronger isolation
